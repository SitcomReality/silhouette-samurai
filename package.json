{
  "name": "silhouette-samurai",
  "version": "0.1.0",
  "private": true,
  "description": "A single-contour-line SDF action platformer for the browser.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "check": "node scripts/check.mjs",
    "check:static": "node ../webgame-tools/bin/webgame-harness.mjs check",
    "smoke": "node ../webgame-tools/bin/webgame-harness.mjs smoke",
    "visual": "node ../webgame-tools/bin/webgame-harness.mjs visual",
    "visual:update": "node ../webgame-tools/bin/webgame-harness.mjs visual --update",
    "runs": "node ../webgame-tools/bin/webgame-harness.mjs runs"
  },
  "engines": {
    "node": ">=18"
  }
}
